<?php

/**
 * JWE keystore for encrypted request/response payloads (see
 * App\Services\EncryptionService).
 *
 * THE REAL FILE IS NOT COMMITTED. Copy this to config/keystore.php and
 * generate one key per environment:
 *
 *   php -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "=") . PHP_EOL;'
 *
 * `kid` is what ties a key to an environment: config/encryption.php maps
 * APP_ENV -> kid, and EncryptionService selects the matching key from this
 * set. Keeping several keys in the set at once is what makes key rotation
 * possible without downtime — the new key is added, traffic moves to it by
 * changing the kid mapping, and the old key stays available to decrypt
 * anything still in flight until it can be removed.
 *
 * "kty": "oct" + "alg": "A128CBC-HS256" means these are SYMMETRIC keys: the
 * same secret encrypts and decrypts, so this file is as sensitive as a
 * password file and must never reach a repository or a log.
 */

return [
    "keys" => [
        [
            "kty" => "oct",
            "kid" => "00000000-0000-0000-0000-000000000001",
            "use" => "enc",
            "alg" => "A128CBC-HS256",
            "k"   => env('JWE_KEY_LOCAL', 'replace-me-with-a-generated-key'),
        ],
        [
            "kty" => "oct",
            "kid" => "00000000-0000-0000-0000-000000000002",
            "use" => "enc",
            "alg" => "A128CBC-HS256",
            "k"   => env('JWE_KEY_STAGING', 'replace-me-with-a-generated-key'),
        ],
        [
            "kty" => "oct",
            "kid" => "00000000-0000-0000-0000-000000000003",
            "use" => "enc",
            "alg" => "A128CBC-HS256",
            "k"   => env('JWE_KEY_PRODUCTION', 'replace-me-with-a-generated-key'),
        ],
    ],
];
